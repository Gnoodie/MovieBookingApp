rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────
    // Helper functions
    // ─────────────────────────────────────────

    /// Kiểm tra request có JWT hợp lệ từ Firebase Auth hay không
    function isAuthenticated() {
      return request.auth != null;
    }

    /// Kiểm tra user đang thao tác chính là owner của document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ─────────────────────────────────────────
    // Movies — public read
    // ─────────────────────────────────────────
    match /movies/{movieId} {
      allow read: if true;          // Public: ai cũng xem được danh sách phim
      allow write: if false;        // Chỉ seed script / admin ghi
    }

    // ─────────────────────────────────────────
    // Cinemas — public read
    // ─────────────────────────────────────────
    match /cinemas/{cinemaId} {
      allow read: if true;
      allow write: if false;
    }

    // ─────────────────────────────────────────
    // Showtimes — public read, ghế cần đăng nhập để giữ/đặt
    // ─────────────────────────────────────────
    match /showtimes/{showtimeId} {
      allow read: if true;
      allow write: if false;

      // Sub-collection seats — đọc & ghi public để trải nghiệm giữ ghế mượt mà
      match /seats/{seatId} {
        allow read, write: if true;
      }
    }

    // ─────────────────────────────────────────
    // FnB Items — public read
    // ─────────────────────────────────────────
    match /fnb_items/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    // ─────────────────────────────────────────
    // Orders — YÊU CẦU ĐĂNG NHẬP (Chỉ chủ sở hữu được đọc/tạo)
    // ─────────────────────────────────────────
    match /orders/{orderId} {
      // Đọc: chỉ user sở hữu order mới xem được
      allow read: if isAuthenticated()
                  && resource.data.userId == request.auth.uid;

      // Tạo: chỉ user đã đăng nhập được tạo đơn hàng cho chính mình
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;

      // Update/Delete: không cho phép từ client (chỉ qua Transaction)
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────
    // Tickets — chỉ chủ sở hữu được đọc/cập nhật
    // ─────────────────────────────────────────
    match /tickets/{ticketId} {
      // Đọc: chỉ user sở hữu vé
      allow read: if isAuthenticated() 
                  && resource.data.userId == request.auth.uid;

      // Tạo: chỉ được tạo cho chính mình
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'active';

      // Update: Cho phép owner cập nhật (ví dụ: huỷ vé - cancelTicket)
      allow update: if isAuthenticated() 
                    && resource.data.userId == request.auth.uid;
                    
      allow delete: if false;
    }

    // ─────────────────────────────────────────
    // Users — chỉ chủ sở hữu được đọc/ghi
    // ─────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ─────────────────────────────────────────
    // Catch-all: chặn mọi thứ còn lại
    // ─────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
